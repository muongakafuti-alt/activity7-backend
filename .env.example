# Copy this file to .env and fill in your own values. Never upload .env to GitHub.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Websites allowed to call the API from a browser (comma separated, no spaces needed)
CLIENT_ORIGINS=http://localhost:8000,http://localhost:5500,https://YOUR-FRONTEND.netlify.app
# Set to false only when using a Postgres server on your own computer
DATABASE_SSL=true
